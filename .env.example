# BasketStat Environment Configuration
# Copy this file to .env and fill in your values

# JSONbin.io Configuration
# Get your API key at: https://jsonbin.io/app/api-keys
JSONBIN_API_KEY=your_api_key_here
JSONBIN_BIN_ID=your_bin_id_here

# ----------------------------------------
# Bootstrap login (first-run only)
# ----------------------------------------
# When the user store is EMPTY, these env passwords let the first account sign in
# and are used to create it (ADMIN_PASSWORD -> admin, APP_PASSWORD -> user).
# Once any account exists, login is handled entirely by the user store and these
# are ignored. Keep at least ADMIN_PASSWORD set so you can bootstrap the first admin.
APP_PASSWORD=your_password_here
ADMIN_PASSWORD=your_admin_password_here

# Session Secret (recommended - defaults to APP_PASSWORD if not set)
# Signs session cookies AND encrypts the user store at rest. Use a long random
# string in production and DO NOT change it after users exist (see USERS_SECRET).
# SESSION_SECRET=your_random_secret_here

# User store encryption key (optional - defaults to SESSION_SECRET)
# The user store (accounts, password hashes, OAuth links) is encrypted at rest
# with AES-256-GCM using this key. If you change it, existing users become
# unreadable, so set it once and keep it stable.
# USERS_SECRET=your_random_users_secret_here

# Vercel Blob Storage (used for audit logs AND the user store on Vercel)
# Created automatically when you add a Blob store in the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ----------------------------------------
# OAuth / social sign-in (all optional)
# ----------------------------------------
# Buttons only appear for providers that are fully configured. Access is
# invite-only: the user's email must already exist in the user store, or the
# login is rejected. Register this app's callback URL with each provider:
#   {BASE_URL}/api/auth/oauth/google/callback
#   {BASE_URL}/api/auth/oauth/apple/callback
#   {BASE_URL}/api/auth/oauth/vipps/callback

# Base URL used to build OAuth redirect URIs. Optional locally (derived from the
# request); set it in production to your canonical URL, e.g. https://app.example.com
# OAUTH_REDIRECT_BASE_URL=https://your-domain.example

# Google (https://console.cloud.google.com/apis/credentials -> OAuth client ID)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple (https://developer.apple.com -> Certificates, Identifiers & Profiles)
# APPLE_SERVICES_ID is the Services ID (client_id). The private key is the .p8
# contents; put it on one line with literal \n between lines, or paste the PEM.
# APPLE_SERVICES_ID=com.yourteam.basketstat.web
# APPLE_TEAM_ID=your_10_char_team_id
# APPLE_KEY_ID=your_10_char_key_id
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vipps Login (https://portal.vippsmobilepay.com -> your sales unit -> Login)
# Set VIPPS_TEST=1 to use the Vipps test environment (apitest.vipps.no).
# VIPPS_CLIENT_ID=your_vipps_client_id
# VIPPS_CLIENT_SECRET=your_vipps_client_secret
# VIPPS_TEST=0

# Server Configuration
PORT=3000
